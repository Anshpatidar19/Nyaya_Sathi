# Copy this file to .env and fill in real values

# Used to sign JWT auth tokens - set to a long random string in production
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Indian Kanoon API - https://api.indiankanoon.org
# Sign up for API access and put your token here.
INDIAN_KANOON_API_TOKEN=your-indian-kanoon-token-here
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

# LLM provider for the synthesis + validator agents (see architecture in README)
GEMINI_API_KEY=your-gemini-api-key-here

# SQLite by default - swap for a Postgres URL in production
DATABASE_URL=sqlite:///./nyaya_sathi.db
