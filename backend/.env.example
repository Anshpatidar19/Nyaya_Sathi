# Copy this file to .env and fill in real values

JWT_SECRET_KEY=change-this-to-a-long-random-string

# --- Supabase Postgres ---------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION POOLER (port 5432). Replace [YOUR-PASSWORD] with your DB password.
# URL-encode special characters in the password (@ becomes %40, # becomes %23).
DATABASE_URL=postgresql+psycopg2://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase Storage ----------------------------------------------------
# Project Settings -> API. The service_role key bypasses row-level security,
# so it must NEVER be exposed to the frontend - server-side only.
SUPABASE_URL=https://abcdefghijklm.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_BUCKET=user-documents

# --- Legal data sources --------------------------------------------------
INDIAN_KANOON_API_TOKEN=your-indian-kanoon-token-here
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

PINECONE_API_KEY=<paste key here>
PINECONE_INDEX=nyaya-sathi
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
DENSE_FALLBACK=0
DENSE_MIN_SCORE=8.0
DENSE_MIN_COVERAGE=0.34

# Free Gemini tier counts a batch of N as N requests against quota.
EMBED_BATCH_SIZE=20
EMBED_PAUSE_SECONDS=1.5


# --- Demo seed data ------------------------------------------------------
# Only read by `python -m app.seed_demo`. Nothing at runtime touches these.
# The seed script creates its accounts through the Supabase ADMIN API with
# email_confirm=true, so no verification email is ever sent to a fake
# address - the real signup flow and its email confirmation are untouched.
# example.com is IANA-reserved and undeliverable.
DEMO_PASSWORD=DemoPass@2026
DEMO_EMAIL_DOMAIN=example.com
